_ms": 1025, "queued_turn_count": 0, "_label": "goal", "_wall_s": 8.2, "_argv": ["claude", "-p", "--model", "haiku", "--tools", "Read,Write,Edit,Bash,Grep,Glob", "--allowedTools", "Read,Write,Edit,Bash,Grep,Glob", "--disallowedTools", "Agent", "WebFetch", "WebSearch", "--strict-mcp-config", "--setting-sources", "", "--output-format", "json", "--add-dir", "/home/anatoly/llm-intelligence-test/v3/distractors", "--plugin-dir", "/home/anatoly/context-governance-plugin"]}
